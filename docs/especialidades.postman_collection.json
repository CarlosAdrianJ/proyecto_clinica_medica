            "url": "{{baseUrl}}/api/especialidades/{{especialidadId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mismo id', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('especialidadId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "La lista incluye la nueva",
