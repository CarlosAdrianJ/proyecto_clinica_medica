      ]
    },
    {
      "name": "2. Administrador: CRUD y validaciones",
      "item": [
        {
          "name": "Listar especialidades",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/especialidades",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve una lista', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Sólo devuelve activas', () => pm.response.json().forEach(e => pm.expect(e.activo).to.eql(true)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear especialidad",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
