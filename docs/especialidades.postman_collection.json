            "url": "{{baseUrl}}/api/especialidades",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"Especialidad {{runId}}\",\"descripcion\":\"Creada por Postman\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const e = pm.response.json();",
                  "pm.test('Devuelve los datos guardados', () => { pm.expect(e.id).to.be.a('number'); pm.expect(e.nombre).to.eql('Especialidad ' + pm.variables.get('runId')); pm.expect(e.activo).to.eql(true); });",
                  "pm.collectionVariables.set('especialidadId', e.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar especialidad creada",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
