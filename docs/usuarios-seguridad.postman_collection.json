{
  "info": {
    "name": "Clinica - Usuarios y Seguridad",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en una base de pruebas. Crea registros y realiza bajas logicas al finalizar. Completar adminUsername/adminPassword con una cuenta administradora existente."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUsername",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "invalidToken",
      "value": "invalido"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('runId')) pm.variables.set('runId', Date.now().toString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Sin JWT: usuarios rechazado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/usuarios",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Error sin traza ni valores rechazados', () => { const body = pm.response.text() ? pm.response.json() : {}; pm.expect(body).not.to.have.property('trace'); pm.expect(body).not.to.have.property('errors'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login incorrecto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nombreUsuario\":\"{{adminUsername}}\",\"contrasena\":\"incorrecta\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Error sin traza ni valores rechazados', () => { const body = pm.response.text() ? pm.response.json() : {}; pm.expect(body).not.to.have.property('trace'); pm.expect(body).not.to.have.property('errors'); });"
